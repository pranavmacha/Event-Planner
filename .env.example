# Copy to .env in the gatherly directory. An empty key enables labeled demo mode.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
DATABASE_URL=sqlite:///./data/gatherly.db
# PostgreSQL: postgresql+psycopg://gatherly:CHANGE_ME@db:5432/gatherly
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000
# Set true for HTTPS production. Local HTTP needs false.
COOKIE_SECURE=false
STATIC_DIR=../frontend/dist
